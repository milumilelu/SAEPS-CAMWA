% Editable, vector-only mechanism schematic. All labels are native LaTeX.
\begin{tikzpicture}[x=1cm,y=1cm,
  font=\fontsize{9}{11}\selectfont,
  panel/.style={draw=ink,line width=.8pt,rounded corners=1.5pt},
  arrow/.style={-{Latex[length=2.3mm,width=1.5mm]},draw=ink,line width=.8pt},
  txt/.style={align=center,inner sep=2pt,text=ink}]
\definecolor{ink}{RGB}{45,49,54}
\definecolor{inputgray}{RGB}{244,245,246}
\definecolor{stateblue}{RGB}{231,240,248}
\definecolor{energyorange}{RGB}{252,241,226}
% Input bar.
\path[panel,fill=inputgray] (0,0) rectangle (15.6,-1.0);
\node[txt] at (7.8,-.27) {\textbf{Same trained checkpoint, weighting, and parameter perturbation}};
\node[txt] at (7.8,-.70) {$\delta\lambda\quad\longrightarrow\quad y=J_\lambda\delta\lambda$};
% Two parallel choices, connected only by orthogonal arrows.
\draw[arrow] (3.75,-1.0) -- (3.75,-1.53);
\draw[arrow] (11.85,-1.0) -- (11.85,-1.53);
\path[panel,fill=white] (0,-1.55) rectangle (7.5,-6.03);
\path[panel,fill=white] (8.1,-1.55) rectangle (15.6,-6.03);
\path[fill=inputgray] (.02,-1.57) rectangle (7.48,-2.26);
\path[fill=stateblue] (8.12,-1.57) rectangle (15.58,-2.26);
\node[txt] at (3.75,-1.9) {\textbf{Frozen-state baseline}};
\node[txt] at (11.85,-1.90) {\textbf{SAEPS: regularized state relaxation}};
\draw[ink,line width=.8pt] (0,-2.27) -- (7.5,-2.27);
\draw[ink,line width=.8pt] (8.1,-2.27) -- (15.6,-2.27);
% Left mechanism.
\node[txt] at (3.75,-2.72) {Weight adaptation is suppressed};
\node[txt] at (3.75,-3.10) {$\delta\theta=0$};
\node[txt] at (3.75,-3.60) {The full linearized response is retained};
\path[panel,fill=energyorange] (.40,-4.02) rectangle (7.10,-5.01);
\node[txt] at (3.75,-4.32) {$Q_{\rm raw}(y)=\|y\|_2^2$};
\node[txt] at (3.75,-4.73) {$F_{\rm raw}=J_\lambda^\top J_\lambda$};
\node[txt,text width=6.6cm] at (3.75,-5.51) {State-reproducible response\\is counted as parameter sensitivity};
% Right mechanism.
\node[txt] at (11.85,-2.73) {$z_\gamma=\underset{z}{\arg\min}\,\bigl\{\|J_\theta z-y\|_2^2+\gamma\|z\|_2^2\bigr\}$};
\node[txt] at (11.85,-3.25) {Compensating displacement: $\delta\theta=-z_\gamma$};
\node[txt] at (11.85,-3.65) {Retained residual \emph{and} displacement cost};
\path[panel,fill=energyorange] (8.50,-4.02) rectangle (15.20,-5.01);
\node[txt] at (11.85,-4.32) {$Q_\gamma(y)=\|A_\gamma y\|_2^2+\gamma\|z_\gamma\|_2^2$};
\node[txt] at (11.85,-4.73) {$F_{\rm se}^{\rm GN}=J_\lambda^\top A_\gamma J_\lambda$};
\node[txt,text width=6.6cm] at (11.85,-5.51) {Parameter curvature after\\regularized local compensation};
% Bottom comparison; no overlapping labels or diagonal connector.
\draw[arrow] (3.75,-6.03) -- (3.75,-6.42) -- (6.0,-6.42) -- (6.0,-6.76);
\draw[arrow] (11.85,-6.03) -- (11.85,-6.42) -- (9.6,-6.42) -- (9.6,-6.76);
\path[panel,fill=inputgray] (0,-6.78) rectangle (15.6,-8.06);
\node[txt] at (7.8,-7.12) {$\displaystyle 0\preceq F_{\rm se}^{\rm GN}\preceq F_{\rm raw}$};
\node[txt] at (7.8,-7.66) {\textbf{Post-training diagnostic only; fitted parameters remain unchanged.}};
\end{tikzpicture}
